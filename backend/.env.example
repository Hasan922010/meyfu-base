# === Django ===
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
TIME_ZONE=Asia/Tashkent

# "Ish kuni" boshlanish soati (kechki sotuvlar to'g'ri kunga tushishi uchun)
BUSINESS_DAY_START_HOUR=6

# Birinchi SUPER_ADMIN (entrypoint `ensure_superuser` orqali yaratadi).
# STANDART PAROL YO'Q — ikkalasini ham to'ldiring yoki ikkalasini ham bo'sh
# qoldiring. Admin yaratilgach bu qatorlarni .env dan olib tashlang.
DJANGO_SUPERUSER_PHONE=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_NAME=Bosh admin

# === Database ===
DATABASE_URL=postgres://meyfu:meyfu@db:5432/meyfu

# === Redis (channel layer + cache + celery broker) ===
REDIS_URL=redis://redis:6379/0

# === JWT ===
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === MinIO / S3-mos xotira ===
USE_S3=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=meyfu-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_CUSTOM_DOMAIN=

# === Sentry (ixtiyoriy — xatoliklar monitoringi, faqat prod) ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# === Operator pochtalari (500 xatolar shu manzillarga boradi, vergul bilan) ===
ADMIN_EMAILS=

# === Telegram bot (ixtiyoriy — bo'sh bo'lsa bot o'chirilgan) ===
# Tokenni @BotFather dan oling. HECH QACHON git'ga commit qilmang — faqat .env da.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MeyFuBot
# Webhook siri — token berilsa MAJBURIY va kuchli (≥16 belgi):
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# === Naklit OCR (ixtiyoriy — kalit bo'lmasa mock provider ishlatiladi) ===
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5
OCR_DAILY_COST_LIMIT_USD=5.00
OCR_MONTHLY_COST_LIMIT_USD=100.00

# === Backup ===
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
